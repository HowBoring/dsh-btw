@startuml
' dsh-btw plugin-first architecture
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Human Operator" as Operator

package "DSH Client (Web / CLI adapters)" {
  [BTW Input Route] as Input
  [BTW History / Follow Panel] as Panel
  [Remote BTW Client] as Client
}

package "dsh-btw Host" {
  [Typed BTW Remote] as Remote
  [BtwCoordinator] as Coord
  [LiveContextMirror] as Mirror
  [BtwSnapshotBuilder] as Snap
  [SideContextNormalizer] as Norm
  [EphemeralBtwRunner] as Runner
  [BtwTopicRepository] as Repo
  [BtwStreamHub] as Hub
}

package "DSH Existing Services" {
  [Main ReactLoopAgent] as Main
  database "Session Event Log" as Session
  [LLM Runtime] as LLM
  [Storage Domain] as Store
  [Remote Access] as Access
}

Operator --> Input
Operator --> Panel
Input --> Client
Panel --> Client
Client --> Remote
Remote --> Access : authorize Session
Remote --> Coord
Coord --> Snap : synchronous capture
Snap --> Mirror : process-local stream cut
Snap --> Session : committed messages
Mirror <-- Main : agent/assistant-stream
Mirror <-- LLM : llm/stream main call
Coord --> Norm : immutable snapshot
Norm --> Runner : valid side history
Coord --> Repo : persist running/settled
Repo --> Store
Runner --> LLM : independent side call
Runner --> Hub : deltas / outcome
Hub --> Remote : watch frames

note bottom of Main
  BTW does NOT call main Agent inbox,
  cancel, runMaintenance or tools executor.
end note

note bottom of Store
  Session-scoped BTW sidecars,
  never model-visible Session messages.
end note
@enduml
